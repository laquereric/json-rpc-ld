# Per-StoreFile ALLOW-LIST shape (v0.2) -- plan section 6.
# GENERATED by the server from its authoritative allow-list; the client mirrors it READ-ONLY
# to pre-validate a SyncIntent before push. Example shown for a task-board StoreFile.
@prefix sh:  <http://www.w3.org/ns/shacl#> .
@prefix sf:  <https://sync.example.org/ns/storefile#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix cyb: <https://railsruntimes.org/ns/cyborg-shapes#> .

# The ONLY publishable fields for this StoreFile are /tool:title and /tool:status.
# A patch touching any other path fails -- the allow-list is the boundary, in SHACL.
cyb:AllowList_task_board_PatchShape a sh:NodeShape ;
  sh:targetClass sf:Patch ;
  sh:property [ sh:path sf:path ; sh:in ( "/tool:title" "/tool:status" ) ;
                sh:message "Field not in the StoreFile allow-list." ] ;
  sh:property [ sh:path sf:op ;   sh:in ( "add" "replace" "remove" ) ] .

# Per-path value profiles are generated too (example: title is a bounded string).
cyb:AllowList_task_board_TitleValueShape a sh:NodeShape ;
  sh:targetClass sf:Patch ;
  sh:property [ sh:path sf:value ; sh:datatype xsd:string ; sh:maxLength 2000 ] .
