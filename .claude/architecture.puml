@startuml JsonRpcLdArchitecture
!theme plain
title JSON-RPC-LD: API Gateway Architecture

' === ACTORS ===
actor "Client" as client
actor "MCP Client" as mcpClient

' === CONTROLLER LAYER ===
package "API Gateway (Controllers)" #ffd54f {
    component "RpcController" as rpcCtrl
    component "McpController" as mcpCtrl #fff3e0
    component "ContextController" as ctxCtrl #e3f2fd
    component "InfoController" as infoCtrl #c8e6c9
}

note right of rpcCtrl
    JSON-RPC 2.0
    Service Router
end note

note right of mcpCtrl
    Model Context
    Protocol Bridge
end note

' === SERVICE DISCOVERY ===
package "Service Registry" #f8bbd9 {
    component "mcp-skill-sot" as skillSot
    component "ENV Fallback" as envFallback #e8e8e8
}

note right of skillSot
    Mcp model
    Skill model
end note

' === DOWNSTREAM SERVICES ===
package "Microservices" #e8f5e9 {
    component "at_context :3017" as ctxSvc
    component "magentic_id :3011" as idSvc
    component "magentic_mail :3012" as mailSvc
    component "magentic_rubygems :3015" as gemsSvc
    component "magentic_github :3013" as gitSvc
    component "magentic_host :3014" as hostSvc
}

' === CONNECTIONS ===
client --> rpcCtrl : POST /rpc
client --> ctxCtrl : GET /context
client --> infoCtrl : GET /

mcpClient --> mcpCtrl : POST /mcp
mcpClient --> mcpCtrl : GET /.well-known/mcp.json

rpcCtrl --> skillSot : lookup service
rpcCtrl --> envFallback : fallback URLs

rpcCtrl --> ctxSvc : context.*
rpcCtrl --> idSvc : identity.*
rpcCtrl --> mailSvc : mail.*
rpcCtrl --> gemsSvc : rubygems.*
rpcCtrl --> gitSvc : github.*
rpcCtrl --> hostSvc : host.*

' === REQUEST FLOW ===
note as flow
    **Request Routing**

    1. Client sends JSON-RPC request
       method: "service.action"
    2. RpcController parses method
    3. Lookup service URL from registry
    4. Forward to service /api/v1/rpc
    5. Wrap response in JSON-LD context
    6. Return to client
end note

' === API ENDPOINTS ===
note as endpoints
    **Endpoints**
    POST /rpc - JSON-RPC 2.0
    GET /rpc/methods - List methods
    GET /.well-known/mcp.json - MCP manifest
    POST /mcp - MCP calls
    GET /mcp/tools - List tools
    GET /context - JSON-LD vocab
    GET / - API info

    **Error Codes**
    -32700: Parse error
    -32600: Invalid request
    -32601: Method not found
    -32603: Internal error
end note

' === LEGEND ===
legend right
    |= Color |= Meaning |
    | <#ffd54f> | JSON-RPC Gateway |
    | <#fff3e0> | MCP Bridge |
    | <#e3f2fd> | JSON-LD Context |
    | <#f8bbd9> | Skill Registry |
    | <#e8f5e9> | Microservice |
endlegend

@enduml
